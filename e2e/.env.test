# E2E Test Environment Configuration

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000

# Database Configuration for Testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Test Data Configuration
TEST_TENANT_PREFIX=e2e-test
TEST_ADMIN_EMAIL_DOMAIN=e2e-test.local

# API Configuration
API_BASE_URL=http://localhost:8000/api

# Enhanced Test Timeouts (in milliseconds) - Increased for long-running tenant operations
DEFAULT_TIMEOUT=60000
API_TIMEOUT=60000
NAVIGATION_TIMEOUT=60000
TENANT_CREATION_TIMEOUT=180000
BULK_OPERATION_TIMEOUT=120000

# Test User Credentials
TEST_SUPER_ADMIN_EMAIL=superadmin@e2e-test.local
TEST_SUPER_ADMIN_PASSWORD=TestPassword123!

# Cleanup Configuration
CLEANUP_TEST_DATA=true
PRESERVE_FAILED_TEST_DATA=true

# Browser Configuration
HEADLESS=true
SLOW_MO=0

# Enhanced Debugging & Logging
DEBUG_API_CALLS=true
VERBOSE_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_VALIDATION_LOGGING=true

# Enhanced Validation Configuration
ENABLE_ENHANCED_VALIDATION=true
VALIDATION_ENVIRONMENT_ENABLED=true
VALIDATION_DATABASE_ENABLED=true
VALIDATION_TENANT_ENABLED=true
VALIDATION_SEEDING_ENABLED=true

# Validation Timeouts (in milliseconds)
VALIDATION_ENVIRONMENT_TIMEOUT=30000
VALIDATION_DATABASE_TIMEOUT=45000
VALIDATION_TENANT_TIMEOUT=60000
VALIDATION_SEEDING_TIMEOUT=90000

# Rollback Protection Configuration
ENABLE_ROLLBACK_PROTECTION=true
AUTO_ROLLBACK_ON_FAILURE=true
PRESERVE_SNAPSHOTS_ON_SUCCESS=false

# Performance Monitoring Configuration
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_COLLECT_MEMORY=true
PERFORMANCE_COLLECT_DATABASE=true
PERFORMANCE_COLLECT_NETWORK=true
PERFORMANCE_REPORT_FORMAT=console
PERFORMANCE_MAX_VALIDATOR_DURATION=10000
PERFORMANCE_MAX_TOTAL_DURATION=180000
PERFORMANCE_MAX_MEMORY_USAGE=200971520
PERFORMANCE_MAX_DATABASE_QUERIES=100
PERFORMANCE_MAX_NETWORK_REQUESTS=50

# Job Monitoring Configuration
JOB_MONITORING_ENABLED=true
JOB_MONITORING_POLL_INTERVAL=3000
JOB_MONITORING_TIMEOUT=180000
JOB_MONITORING_MAX_RETRIES=5
JOB_MONITORING_QUEUES=default,tenant-creation
JOB_MONITORING_CONNECTIONS=database
JOB_MONITORING_TENANT_TYPES=tenant-setup,tenant-seed

# Permission Testing Configuration
ENABLE_PERMISSION_TESTING=true
TEST_ROLE_ISOLATION=true
TEST_TENANT_ISOLATION=true
TEST_PERMISSION_INHERITANCE=true

# Advanced Error Handling
ENABLE_DETAILED_ERROR_REPORTING=true
COLLECT_ERROR_DIAGNOSTICS=true
ENABLE_ACTIONABLE_ERROR_MESSAGES=true

# Skip validation for rapid testing (set to true to skip)
SKIP_PRE_TEST_VALIDATION=false
